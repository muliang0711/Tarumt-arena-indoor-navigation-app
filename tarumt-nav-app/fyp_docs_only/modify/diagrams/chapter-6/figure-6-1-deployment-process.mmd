flowchart LR
    subgraph Backend["Backend Release"]
        direction TB
        A["Commit one verified Git revision"] --> B["Archive and upload revision to Google Cloud VM"]
        B --> C["Create versioned release directory"]
        C --> D["Validate production environment and Compose model"]
        D --> E["Build and start Docker containers"]
        E --> F["Wait for container health checks"]
        F --> G["Run deployment smoke test"]
        G --> H{"All checks pass?"}
        H -->|"Yes"| I["Point current symlink to new release"]
        H -->|"No"| J["Keep previous current release"]
    end

    subgraph Android["Android APK Release"]
        direction TB
        K["Verify Flutter project and version"] --> L["Build release APK with service URLs"]
        L --> M["Generate SHA-256 checksum"]
        M --> N["Transfer APK to Android device"]
        N --> O["Install or update application"]
        O --> P["Grant required runtime permissions"]
    end
