# Copy this file to /opt/campus-navigator/shared/production.env on the CMP.
# Keep the real file server-only with mode 0600. Values must not be committed.
#
# Secrets are deliberately restricted to ASCII letters, digits, "_" and "-"
# so the same file is safe for Docker Compose and deployment shell tooling.

PRESENCE_HOST_PORT=8080
PRESENCE_INSTANCE_ID=cmp-gateway-1
PRESENCE_ALLOWED_ORIGINS=

PRESENCE_JWT_SECRET=replace_with_a_random_value_at_least_32_chars
PRESENCE_IDENTITY_HMAC_SECRET=replace_with_another_random_value_32_chars
CLICKHOUSE_TRAJECTORY_PASSWORD=replace_with_a_random_writer_password_32_chars
CLICKHOUSE_ANALYTICS_PASSWORD=replace_with_a_random_reader_password_32_chars

